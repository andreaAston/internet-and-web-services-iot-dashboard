{
  "openapi": "3.0.3",
  "info": {
    "title": "Smart Access Monitor API",
    "version": "1.0.0",
    "description": "JWT login for dashboard reads; per-device API key for Pi writes. All timestamps are server-generated. Import this file into Swagger Editor or Postman. Cookies are also accepted for dashboard reads."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "deviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "smart_access_token"
      }
    }
  },
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Log in (also sets an HTTP-only cookie; token expires in 8 hours)",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "token": "<JWT>"
                }
              }
            }
          },
          "400": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Invalid request"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Login required"
                }
              }
            }
          },
          "500": {
            "description": "Server/database failure; retry later",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Internal server error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "username": "admin",
                "password": "<your-password>"
              }
            }
          }
        }
      }
    },
    "/api/telemetry": {
      "post": {
        "summary": "Store one complete sensor reading; update online time and environmental alerts",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Telemetry stored"
                }
              }
            }
          },
          "400": {
            "description": "Bad input",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Invalid request"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Login required"
                }
              }
            }
          },
          "500": {
            "description": "Server/database failure; retry later",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Internal server error"
                }
              }
            }
          }
        },
        "security": [
          {
            "deviceKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_uid",
                  "temperature",
                  "humidity",
                  "gas_present",
                  "fan_on"
                ],
                "properties": {
                  "device_uid": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "temperature": {
                    "type": "number",
                    "nullable": true,
                    "minimum": -273.15,
                    "maximum": 1000
                  },
                  "humidity": {
                    "type": "number",
                    "nullable": true,
                    "minimum": 0,
                    "maximum": 100
                  },
                  "gas_present": {
                    "type": "boolean",
                    "nullable": true
                  },
                  "fan_on": {
                    "type": "boolean",
                    "nullable": true
                  }
                }
              },
              "example": {
                "device_uid": "main-entrance-pi",
                "temperature": 24.6,
                "humidity": 58,
                "gas_present": false,
                "fan_on": false
              }
            }
          }
        },
        "description": "All four reading fields are required. Use null for an unavailable sensor or unknown fan state; omitted fields and invalid types are rejected. Null readings do not clear existing alerts. A valid packet updates device last_seen even if all readings are null. Device online indicates communication, not sensor health."
      }
    },
    "/api/dashboard": {
      "get": {
        "summary": "Current readings (aliases of the same handler)",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "temperature": 24.6,
                  "humidity": 58,
                  "gas_status": "safe",
                  "fan_status": "off",
                  "device_online": true,
                  "last_seen": "2026-10-03T06:00:00Z"
                }
