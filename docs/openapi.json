                "example": {
                  "success": false,
                  "message": "Internal server error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown device",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Device not found"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "device_uid",
            "in": "query",
            "description": "Filter by registered device UID. Omit to query all devices (latest device for current KPI).",
            "schema": {
              "type": "string"
            },
            "example": "main-entrance-pi"
          }
        ],
        "description": "Online means a valid reading was received within 2 minutes. Before first telemetry, readings/status strings and last_seen are null, online is false."
      }
