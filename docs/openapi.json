    "/api/device/verify-access": {
      "post": {
        "summary": "Verify the enrolled RFID card and PIN together; either may be entered first on the Pi",
        "security": [
          {
            "deviceKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["device_uid", "card_uid", "pin"],
                "properties": {
                  "device_uid": {"type": "string", "maxLength": 100},
                  "card_uid": {"type": "string", "maxLength": 64},
                  "pin": {"type": "string", "pattern": "^[0-9]{4,8}$"}
                }
              },
              "example": {
                "device_uid": "main-entrance-pi",
                "card_uid": "<card UID>",
                "pin": "1234"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pair checked; invalid factors receive a generic denial",
            "content": {
              "application/json": {
                "examples": {
                  "granted": {"value": {"granted": true, "reason": "authorized", "user_id": 1, "card_id": 1, "name": "Example User"}},
                  "denied": {"value": {"granted": false, "reason": "invalid_credentials"}}
                }
              }
            }
          },
          "400": {"description": "Invalid request body"},
          "401": {"description": "Missing or invalid device API key"},
          "429": {"description": "PIN attempts rate-limited"},
          "500": {"description": "Server/database failure; access must remain denied"}
        },
        "description": "The raw PIN is checked against a bcrypt hash and the card UID against its SHA-256 hash. The Pi must not grant access unless this endpoint returns granted=true."
      }
    },
