        "security": [
          {
            "deviceKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "device_uid": "main-entrance-pi",
                "method": "pin",
                "result": "denied",
                "reason": "wrong_pin"
              }
            }
          }
        },
        "description": "Required method: rfid or pin; result: granted or denied. Optional reason (max 50 chars), user_id, card_id, snapshot_id (existing positive integer IDs or null). Pi performs access checking. No PINs or raw card UIDs are sent here."
      },
