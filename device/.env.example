# Copy to .env and fill in. NEVER commit .env to GitHub.
# Address of the laptop running Express (same Wi-Fi / phone hotspot as the Pi)
SERVER_URL=http://192.168.43.100:3000
# The plain API key whose SHA-256 hash is stored in devices.api_key_hash
DEVICE_API_KEY=put-the-real-key-here
# Matches devices.device_uid in the database
DEVICE_UID=main-entrance-pi
